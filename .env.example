# Copiar a Render → Environment. No subir secretos al repo.

# Obligatorio en producción (Neon / Supabase / Render Postgres).
# Sin esto los datos se pierden al dormir el plan free.
DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require

# Cookie segura y proxy de Render.
NODE_ENV=production
TRUST_PROXY=1

# Neon/Supabase: dejar true. Solo false si el certificado del servidor es de confianza estricta.
PGSSL_NO_VERIFY=true

# Lo pone Render. No hace falta crearla.
# PORT=10000
