# Copiar a las Variables de entorno de tu hosting (por ejemplo Railway →
# pestaña "Variables"). No subir secretos al repo.

# Obligatorio en producción si el hosting no tiene disco persistente (caso de
# Railway, Render y similares). Sin esto los datos se pierden en cada
# despliegue o reinicio. En Railway, si añades el plugin de PostgreSQL del
# propio proyecto, esta variable se puede definir como referencia automática
# ${{Postgres.DATABASE_URL}} en vez de pegar la cadena a mano.
DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require

# Cookie segura y proxy del hosting (Railway y similares van detrás de proxy).
NODE_ENV=production
TRUST_PROXY=1

# Postgres gestionado (Railway, Neon, Supabase...): dejar true. Solo false si
# el certificado del servidor es de confianza estricta.
PGSSL_NO_VERIFY=true

# Lo pone el hosting automáticamente (Railway, Render...). No hace falta crearla.
# PORT=10000
